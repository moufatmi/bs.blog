---
// src/components/DynamicPrograms.astro
import { fetchProgramsFeed, isFeedConfigured, warnIfFeedMissing, toDisplayableImage, type FeedProgram } from '../lib/programsFeed';
import ProgramFlyerCard from './ProgramFlyerCard.astro';

interface Props {
  lang?: 'ar' | 'fr';
}

const { lang = 'ar' } = Astro.props;
const isAr = lang === 'ar';

// القيم الافتراضية عند غياب البيانات (تُستخدم من الخادم ومن المتصفح)
const fallbackTitle = isAr ? 'برنامج عمرة وجدة' : 'Programme Omra Oujda';
const fallbackPrice = isAr ? 'اتصل للمزيد' : 'Sur demande';

// جلب البيانات وقت البناء (نسخة احتياطية فقط)
// المصدر الحقيقي هو Google Sheet، والمتصفح يحدّث نفسه عند كل زيارة.
let initialPrograms: FeedProgram[] = [];
let initialFetchFailed = false;
if (warnIfFeedMissing()) {
  initialFetchFailed = true;
} else {
  try {
    initialPrograms = await fetchProgramsFeed();
  } catch (e) {
    initialFetchFailed = true;
    console.error('Could not load the programs feed at build time:', e);
  }
}

const programCards = await Promise.all(
  initialPrograms.map(async (program) => ({
    id: program.id,
    title: program.title || fallbackTitle,
    description: program.description,
    price: program.price || fallbackPrice,
    // Resolved at build time too, so the first paint already shows photos.
    imageUrl: await toDisplayableImage(program.image_url),
  }))
);
---

<div class="dynamic-programs-wrapper my-4" dir={isAr ? "rtl" : "ltr"}>

  <!-- ترويسة القسم -->
  <div class="text-center mb-10">
    <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-brand-teal/10 text-brand-teal dark:bg-cyan-500/10 dark:text-cyan-400 mb-3 tracking-wider uppercase">
      {isAr ? "مباشرة من الوكالة • تحديث فوري" : "Direct de l'agence • Mis à jour"}
    </span>
    <h2 class="text-3xl lg:text-4xl font-extrabold text-brand-teal dark:text-cyan-400">
      {isAr ? "أحدث برامج العمرة المعلنة" : "Nos Dernières Offres Publiées"}
    </h2>
    <p class="mt-2 text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-sm md:text-base">
      {isAr
        ? "برامج ورحلات حصرية ومباشرة من مطار وجدة أنجاد. اضغط على أي إعلان لعرض التفاصيل الكاملة أو الحجز المباشر."
        : "Programmes exclusifs avec vols directs depuis Oujda. Cliquez sur l'affiche pour agrandir ou réservez directement."}
    </p>
    <div class="w-20 h-1 bg-gradient-to-r from-brand-teal to-gold mx-auto mt-4 rounded-full"></div>
  </div>

  <!-- شبكة عرض البرامج (تُملأ من الخادم، ويستكملها العميل) -->
  <div id="dynamic-programs-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {programCards.map((program) => (
      <ProgramFlyerCard
        lang={lang}
        title={program.title}
        description={program.description}
        price={program.price}
        imageUrl={program.imageUrl}
        programId={program.id}
      />
    ))}
  </div>

  <!-- حالة عدم وجود برامج -->
  {programCards.length === 0 && (
    <div id="no-dynamic-programs" class="text-center py-16 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm">
      <p class="text-xl font-medium text-gray-500 dark:text-gray-400">
        {isAr ? "لا توجد برامج حصرية منشورة حالياً." : "Aucune offre exclusive pour le moment."}
      </p>
      <p class="text-sm text-gray-400 mt-2">
        {isAr ? "يرجى متابعة الصفحة أو الاتصال بنا مباشرة لمعرفة أحدث المواعيد." : "Revenez bientôt ou contactez-nous مباشرة."}
      </p>
    </div>
  )}

  <!--
    قالب بطاقة يُستخدم من JavaScript لتوليد البطاقات في المتصفح.
    هذا خط الدفاع: إذا فشل جلب Supabase وقت البناء، أو أُضيف برنامج جديد بعد النشر.
  -->
  <template id="program-card-template">
    <ProgramFlyerCard lang={lang} />
  </template>

  <script is:inline type="application/json" id="program-card-config" set:html={JSON.stringify({
    lang,
    isAr,
    fallbackTitle,
    fallbackPrice,
    initialFetchFailed,
  })} />

</div>

<!-- نافذة عرض الملصق الإعلاني مكبراً (Poster Lightbox Modal)
     z-[60] ضروري: الزر العائم لواتساب في Layout.astro ثابت بـ z-50 ويأتي بعد هذا المكوّن في DOM،
     فبدون رفع الـ z-index كان يظهر فوق النافذة ويمنع التفاعل معها -->
<div id="flyer-modal" data-lang={lang} class="fixed inset-0 z-[60] bg-black/85 backdrop-blur-md hidden flex flex-col items-center justify-center gap-4 p-4 sm:p-6 overflow-y-auto">
  <div class="w-full max-w-4xl flex flex-col items-center gap-4">
    <div class="w-full flex items-center justify-end">
      <button id="close-flyer-modal" class="text-white hover:text-gold transition-colors px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-sm font-bold cursor-pointer flex items-center gap-2">
        <span>{isAr ? "إغلاق" : "Fermer"}</span>
        <span aria-hidden="true">✕</span>
      </button>
    </div>

    <!-- الصورة: تملأ عرض النافذة مع الحفاظ على النسبة دون أي تشويه -->
    <img
      id="flyer-modal-img"
      src=""
      alt={isAr ? "ملصق البرنامج" : "Affiche du programme"}
      decoding="async"
      class="w-full h-auto max-w-full max-h-[85vh] object-contain mx-auto rounded-lg shadow-2xl"
    />

    <div class="flex gap-4">
      <a
        id="flyer-modal-wa-btn"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#25D366] hover:bg-[#20ba5a] text-white px-6 py-2.5 rounded-full font-bold text-sm shadow-xl flex items-center gap-2 transition-all hover:scale-105"
      >
        <span>{isAr ? "احجز بخصوص هذا العرض عبر واتساب" : "Réserver cette offre via WhatsApp"}</span>
      </a>
    </div>
  </div>
</div>

<!-- كود JavaScript للجهة العميل (Client-side) -->
<script>
  import { FEED_URL, fetchProgramsFeed, isFeedConfigured, warnIfFeedMissing, toDisplayableImage, type FeedProgram } from '../lib/programsFeed';

  const WHATSAPP_NUMBER = '212699922229';

  // الصورة تأتي مباشرة من صف Google Sheet (رابط Drive عام)
  /** يستخرج معرّف ملف Drive من أي رابطdrive. */
  function extractDriveId(url) {
    const m = String(url || '').match(/[?&]id=([A-Za-z0-9_-]{6,})/);
    return m ? m[1] : '';
  }

  function imageUrlOf(prog) {
    return String(prog?.image_url || '').trim();
  }

  function readConfig() {
    const node = document.getElementById('program-card-config');
    if (!node) return { lang: 'ar', isAr: true };
    try {
      return JSON.parse(node.textContent || '{}');
    } catch (e) {
      return { lang: 'ar', isAr: true };
    }
  }

  // توليد بطاقة من القالب <template> — يغطي الحالات التي لم يصل فيها بناء الخادم
  function renderCardFromTemplate(prog, config) {
    const template = document.getElementById('program-card-template');
    const grid = document.getElementById('dynamic-programs-grid');
    if (!template || !grid) return null;

    const fragment = template.content.cloneNode(true);
    const card = fragment.querySelector('[data-program-card]');
    if (!card) return null;

    const title = prog.title || config.fallbackTitle;
    const description = prog.description && prog.description !== prog.title ? prog.description : '';
    const price = prog.price || config.fallbackPrice;
    const image = imageUrlOf(prog);

    card.setAttribute('data-program-id', prog.id ?? '');

    const titleEl = card.querySelector('[data-slot="title"]');
    if (titleEl) titleEl.textContent = title;

    const descEl = card.querySelector('[data-slot="description"]');
    if (descEl) {
      descEl.textContent = description;
      descEl.classList.toggle('hidden', !description);
    }

    const priceEl = card.querySelector('[data-slot="price"]');
    if (priceEl) priceEl.textContent = price;

    // الصورة: القالب يبني الحالة "بدون صورة"، لذلك نكشف الصورة ونخفي البديل
    const img = card.querySelector('.program-flyer-thumb');
    const placeholder = card.querySelector('[data-slot="image-placeholder"]');
    const zoomBtn = card.querySelector('.program-flyer-btn');

    if (image) {
      // Some photos are served as base64 through the feed script, because the
      // Google account forbids public sharing. Resolve them into a real image.
      toDisplayableImage(image).then((displayable) => {
        if (!displayable) return;

        if (img) {
          img.src = displayable;
          img.alt = title;
          img.classList.remove('hidden');
          img.setAttribute('data-full-img', displayable);
          img.setAttribute('data-title', title);
        }
        if (placeholder) placeholder.classList.add('hidden');
        if (zoomBtn) {
          zoomBtn.classList.remove('hidden');
          zoomBtn.setAttribute('data-full-img', displayable);
          zoomBtn.setAttribute('data-title', title);
        }
      });

      const waBtn = card.querySelector('a[href*="wa.me"]');
      if (waBtn) {
        const msg = config.isAr
          ? `السلام عليكم ورحمة الله، أود الاستفسار والحجز بخصوص: ${title}`
          : `Bonjour, je souhaite réserver pour le programme: ${title}`;
        waBtn.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`;
      }
    } else if (img) {
      img.classList.add('hidden');
    }

    grid.appendChild(fragment);
    return card;
  }

  // تحديث شبكة البطاقات في المتصفح (يغطي البرامج الجديدة والحذف بعد النشر)
  function syncGrid(programs, config) {
    const grid = document.getElementById('dynamic-programs-grid');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('[data-program-card]'));
    const byId = new Map(cards.map((c) => [c.getAttribute('data-program-id'), c]));

    // حذف البطاقة إذا اختفى برنامجها من المصدر.
    // بدون هذه الخطوة تبقى البطاقات القديمة على الشاشة إلى الأبد.
    const liveIds = new Set(programs.map((p) => p.id));
    cards.forEach((card) => {
      const id = card.getAttribute('data-program-id');
      if (!liveIds.has(id)) card.remove();
    });

    programs.forEach((prog) => {
      const existing = prog.id ? byId.get(prog.id) : null;
      if (existing) {
        // تحديث الحقول دون إعادة بناء البطاقة (يحافظ على أي حالة عرض)
        const title = prog.title || config.fallbackTitle;
        const titleEl = existing.querySelector('[data-slot="title"]');
        if (titleEl && titleEl.textContent.trim() !== title) titleEl.textContent = title;

        const price = prog.price || config.fallbackPrice;
        const priceEl = existing.querySelector('[data-slot="price"]');
        if (priceEl && priceEl.textContent.trim() !== price) priceEl.textContent = price;

        const description = prog.description && prog.description !== prog.title ? prog.description : '';
        const descEl = existing.querySelector('[data-slot="description"]');
        if (descEl) {
          descEl.textContent = description;
          descEl.classList.toggle('hidden', !description);
        }

        const image = imageUrlOf(prog);
        const img = existing.querySelector('.program-flyer-thumb');
        if (img && image) {
          const source = img.getAttribute('data-source-img');
          const loaded = img.getAttribute('src');
          // نحدّث إن كان المصدر مختلفاً، أو إن لم تُحمَّل الصورة بعد.
          // الحالة الثانية مهمة: البناء قد ينتج بطاقة بلا src.
          if (source !== image || !loaded) {
            img.setAttribute('data-source-img', image);
            toDisplayableImage(image).then((displayable) => {
              if (!displayable) return;
              img.src = displayable;
              img.alt = title;
              img.classList.remove('hidden');
              img.setAttribute('data-full-img', displayable);
              img.setAttribute('data-title', title);
              const placeholder = existing.querySelector('[data-slot="image-placeholder"]');
              if (placeholder) placeholder.classList.add('hidden');
              const btn = existing.querySelector('.program-flyer-btn');
              if (btn) {
                btn.classList.remove('hidden');
                btn.setAttribute('data-full-img', displayable);
                btn.setAttribute('data-title', title);
              }
            });
          }
        }
        return;
      }

      renderCardFromTemplate(prog, config);
    });

    const emptyState = document.getElementById('no-dynamic-programs');
    const cardCount = grid.querySelectorAll('[data-program-card]').length;
    if (emptyState) emptyState.classList.toggle('hidden', cardCount > 0);
  }

  // استبدال الصور الميتة (404 / 403) بالأيقونة البديلة
  function handleBrokenImages(root) {
    root.querySelectorAll('img.program-flyer-thumb').forEach((img) => {
      if (img.dataset.fallbackApplied) return;

      // عنصر بلا src لا يُظهر شيئاً ولا يُطلق حدث error، فتبقى الأيقونة
      // البديلة فوقه. نخفيه الآن ونستبدله فور وصول الرابط.
      if (!img.getAttribute('src')) img.classList.add('hidden');

      // Drive يرفض عرض الملفات على مواقع أخرى ويرد بـ 403 رغم أن الصورة
      // عامة. عندها نطلبها من السكربت الذي يملك صلاحية قراءتها.
      img.addEventListener('error', async () => {
        const id = extractDriveId(img.getAttribute('src') || '');
        if (id && !img.dataset.viaProxy) {
          img.dataset.viaProxy = '1';
          const proxy = FEED_URL + '?img=' + id;
          const retried = await toDisplayableImage(proxy);
          if (retried) {
            img.src = retried;
            img.classList.remove('hidden');
            img.setAttribute('data-full-img', retried);
            const zoom = img.closest('[data-program-card]')?.querySelector('.program-flyer-btn');
            if (zoom) {
              zoom.classList.remove('hidden');
              zoom.setAttribute('data-full-img', retried);
            }
            const ph = img.closest('[data-program-card]')?.querySelector('[data-slot="image-placeholder"]');
            if (ph) ph.classList.add('hidden');
            return;
          }
        }

        if (img.dataset.fallbackApplied) return;
        img.dataset.fallbackApplied = '1';
        if (img.dataset.fallbackApplied) return;
        img.dataset.fallbackApplied = '1';
        const placeholder = document.createElement('div');
        placeholder.className =
          'w-full h-48 sm:h-56 flex items-center justify-center bg-gray-100 dark:bg-gray-800 text-gray-400';
        placeholder.innerHTML =
          '<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>';
        img.replaceWith(placeholder);
        // بلا صورة لا فائدة من زر التكبير
        const btn = root.querySelector('.program-flyer-btn');
        if (btn) btn.classList.add('hidden');
      });
    });
  }

  // إعداد نافذة تكبير الملصق (مرة واحدة فقط لتجنب تكرار المستمعين)
  let flyerModalBound = false;
  function setupFlyerModal() {
    if (flyerModalBound) return;

    const modal = document.getElementById('flyer-modal');
    const modalImg = document.getElementById('flyer-modal-img');
    const modalWaBtn = document.getElementById('flyer-modal-wa-btn');
    const closeBtn = document.getElementById('close-flyer-modal');

    if (!modal || !modalImg) return;
    flyerModalBound = true;

    const isFrench = modal.getAttribute('data-lang') === 'fr';

    function openModal(imgSrc, title) {
      modalImg.src = imgSrc;
      if (modalWaBtn) {
        const msg = isFrench
          ? `Bonjour, je souhaite réserver pour le programme: ${title}`
          : `السلام عليكم ورحمة الله، أود الحجز والاستفسار بخصوص: ${title}`;
        modalWaBtn.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`;
      }
      modal.classList.remove('hidden');
      // إظهار الصورة بعد تحميلها لتفادي الوميض أثناء التنزيل
      const revealImage = () => modalImg.classList.remove('opacity-0');
      modalImg.classList.add('opacity-0');
      if (modalImg.complete && modalImg.naturalWidth > 0) revealImage();
      else {
        modalImg.onload = revealImage;
        modalImg.onerror = revealImage;
      }
    }

    function closeModal() {
      modal.classList.add('hidden');
    }

    // تفويض الأحداث: يعمل أيضاً مع البطاقات التي ولّدها المتصفح لاحقاً
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.program-flyer-thumb, .program-flyer-btn');
      if (!trigger) return;
      const img = trigger.getAttribute('data-full-img');
      if (img) openModal(img, trigger.getAttribute('data-title') || '');
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  }

  // جلب البيانات من Google Sheet وتحديث الواجهة — لا build ولا deploy
  async function refreshClient() {
    const config = readConfig();
    const grid = document.getElementById('dynamic-programs-grid');
    if (!grid) return;
    if (!isFeedConfigured()) return;

    const programs = await fetchProgramsFeed({ useBrowserCache: true });

    // syncGrid يضيف ويحدّث ويحذف، فيغطي كل الحالات في نداء واحد.
    syncGrid(programs, config);

    const emptyState = document.getElementById('no-dynamic-programs');
    const remaining = grid.querySelectorAll('[data-program-card]').length;
    if (emptyState) emptyState.classList.toggle('hidden', remaining > 0);

    handleBrokenImages(grid);
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupFlyerModal();
    handleBrokenImages(document);
    refreshClient();
  });
</script>